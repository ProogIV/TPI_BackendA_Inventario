# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube a GitHub.

PORT=3000

# Base de datos de desarrollo (MongoDB en Docker: docker run ... mongo:7)
MONGO_URI=mongodb://127.0.0.1:27017/tpi_inventario

# Base de datos exclusiva para los tests (se borra en cada ejecución). Tiene que ser distinta de MONGO_URI.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/tpi_inventario_test

# URL base del servicio de Pedidos (Django)
PEDIDOS_API_URL=http://127.0.0.1:8000/api
